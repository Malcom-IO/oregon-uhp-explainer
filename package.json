{
  "name": "oregon-uhp-explainer",
  "version": "0.1.0",
  "private": true,
  "description": "Plain-language explainer and household calculator for Oregon's proposed Universal Health Plan, built on the Governance Board's published revenue models.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build && vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "pdf": "node scripts/make-pdf.mjs",
    "numbers": "UPDATE_NUMBERS=1 vitest run src/site/numbers.spec.ts",
    "release:assets": "node scripts/release-assets.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
